# Ignore backend build outputs, caches, and local editor files.
# Environment and secrets
.env
.env.*
!.env.example

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments and tooling output
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

# Local databases
*.db
*.sqlite
*.sqlite3

# Editor and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
uv.lock